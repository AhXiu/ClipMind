CLIPMIND_ENV=development
CLIPMIND_ADDR=:8080
CLIPMIND_DATA_DIR=./data
CLIPMIND_VAULT_DIR=./vault
CLIPMIND_AUTH_DISABLED=true
CLIPMIND_AUTH_TOKEN=change-me
# 32 random bytes, base64 encoded; mandatory in production:
# CLIPMIND_BACKUP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Default is ark. Use deterministic only for local/test runs that must not call an LLM.
CLIPMIND_LLM_PROVIDER=ark
CLIPMIND_LLM_TIMEOUT=20s
CLIPMIND_WORKER_INTERVAL=1s
# Inject secrets through the deployment secret manager; never commit a value.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-20260306164116-j9fgc
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional fixed attribution headers; provider operation does not depend on them.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# Legacy openai provider compatibility only:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
