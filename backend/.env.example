CLIPMIND_ENV=development
CLIPMIND_ADDR=:8080
CLIPMIND_DATA_DIR=./data
CLIPMIND_VAULT_DIR=./vault
CLIPMIND_AUTH_DISABLED=true
CLIPMIND_AUTH_TOKEN=change-me
# 32 random bytes, base64 encoded; mandatory in production:
# CLIPMIND_BACKUP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CLIPMIND_LLM_PROVIDER=deterministic
CLIPMIND_LLM_TIMEOUT=20s
CLIPMIND_WORKER_INTERVAL=1s
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
